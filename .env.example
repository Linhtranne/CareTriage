# --- GLOBAL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=caretriage
DB_USERNAME=root
DB_PASSWORD=root
DB_ROOT_PASSWORD=root
JWT_SECRET=your-256-bit-secret-key-here

# --- BACKEND ---
SPRING_PROFILES_ACTIVE=prod
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_KEY=your-internal-api-key-min-32-chars

# --- BACKEND RESILIENCY & TIMEOUTS ---
AI_CONNECT_TIMEOUT_MS=3000
AI_READ_TIMEOUT_SECONDS=30
AI_WRITE_TIMEOUT_SECONDS=10
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_INITIAL_BACKOFF_MS=300
AI_RETRY_MAX_BACKOFF_MS=2000

# --- AI SERVICE ---
INTERNAL_API_KEY=your-internal-api-key-min-32-chars
MAX_BODY_SIZE_BYTES=16777216
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.8
GEMINI_MAX_TOKENS=2048
ENTREZ_EMAIL=admin@caretriage.com
TAVILY_API_KEY=your-tavily-api-key
CHROMA_DB_PATH=./chroma_db
ENABLE_WEB_RESEARCH=false
RAG_ENABLED=false

# --- FRONTEND ---
VITE_API_URL=http://localhost:8080

# --- DEPLOYMENT (GitHub Secrets) ---
DOCKER_USERNAME=your_dockerhub_username
SSH_HOST=your_server_ip
SSH_USER=your_ssh_user
SSH_KEY=your_ssh_private_key
