# -----------------------------------------------------------------------------
# CareTriage AI Service - Environment Variables Configuration
# -----------------------------------------------------------------------------

# --- 🔐 Internal Security & API Control ---
# Secret API key used for internal service communication between Java backend and ai-service.
# Must be a secure base64 string, minimum 32 characters in production.
INTERNAL_API_KEY=your_internal_api_key_minimum_32_characters_long

# Maximum allowed size for request payloads (default: 5MB = 5242880)
MAX_BODY_SIZE_BYTES=16777216

# --- 🧠 LLM Provider Configuration ---
# Active provider: 'gemini' (production) or 'mock' (local testing)
LLM_PROVIDER=gemini

# Google Gemini API key
GEMINI_API_KEY=your_google_gemini_api_key_here

# Core triage, question generation and EHR extraction model
GEMINI_MODEL_NAME=gemini-2.5-pro

# Embedding model for RAG and search lookups
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Model parameters
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.8
GEMINI_MAX_TOKENS=2048

# --- 🔬 Medical Research & RAG Config ---
# Email address required for NCBI Entrez query compliance (PubMed search)
ENTREZ_EMAIL=admin@caretriage.com

# Tavily Search API key (for web search research fallback)
TAVILY_API_KEY=your_tavily_api_key_here

# SQLite Chroma Vector DB folder path
CHROMA_DB_PATH=./chroma_db

# Toggle switches (true/false)
ENABLE_WEB_RESEARCH=false
RAG_ENABLED=false
CLINICAL_CONTEXT_BUILDER_V1=false

# --- 📈 Telemetry & Observability ---
# Telemetry provider: 'noop' (disabled), 'langfuse' (production), or 'structured' (JSON logging)
TELEMETRY_PROVIDER=noop

# Langfuse credentials (required only if TELEMETRY_PROVIDER=langfuse)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# --- 🛠️ Environment Profiles ---
# Testing profile toggle. If set to true, dummy config values are auto-filled
# during unit tests to bypass external service API calls.
TESTING=false
