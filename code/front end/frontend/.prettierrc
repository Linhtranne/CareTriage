{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "jsxBracketSameLine": false,
  "arrowParens": "always",
  "rangeStart": 0,
  "endOfLine": "auto",
  "overrides": [
    {
      "files": "**/*.{js,jsx,ts,tsx}",
      "options": {
        "parser": "babel"
      }
    }
  ]
}

